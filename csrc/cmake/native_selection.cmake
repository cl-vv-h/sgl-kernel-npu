include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/cpp_operators.cmake")

# This layer classifies legacy CANN IDs without changing their declarations or
# relaxing the legacy resolver's source, architecture and execution-unit checks.
function(sgl_select_native_operators out_cann out_cpp)
    cmake_parse_arguments(PARSE_ARGV 2 selection "" "ARCH;BUILD_TYPE" "OPERATORS")
    if(NOT "${selection_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${selection_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid native selection arguments: ${selection_UNPARSED_ARGUMENTS}; missing values: ${selection_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT selection_ARCH MATCHES "^(2201|3510)$" OR NOT selection_OPERATORS)
        message(FATAL_ERROR "Native selection requires ARCH 2201 or 3510 and OPERATORS")
    endif()
    if(selection_BUILD_TYPE AND NOT selection_BUILD_TYPE MATCHES "^(cann|cpp)$")
        message(FATAL_ERROR "Unknown build type: ${selection_BUILD_TYPE}")
    endif()
    sgl_get_registered_operators(cann_ids)
    get_property(cpp_ids GLOBAL PROPERTY SGL_CPP_OPERATOR_IDS)
    foreach(id IN LISTS cpp_ids)
        if(id IN_LIST cann_ids)
            message(FATAL_ERROR "Duplicate operator ID across CANN and CPP registries: ${id}")
        endif()
    endforeach()
    set(requested ${selection_OPERATORS})
    if("ALL" IN_LIST requested)
        if(NOT requested STREQUAL "ALL")
            message(FATAL_ERROR "ALL cannot be combined with explicit operator IDs")
        endif()
        set(requested ${cann_ids} ${cpp_ids})
    endif()
    set(cann)
    set(cpp)
    set(seen)
    foreach(id IN LISTS requested)
        if(id IN_LIST seen)
            message(FATAL_ERROR "Duplicate requested operator: ${id}")
        endif()
        list(APPEND seen "${id}")
        if(id IN_LIST cann_ids)
            set(kind cann)
            sgl_get_operator_field(archs "${id}" SUPPORTED_ARCHS)
        elseif(id IN_LIST cpp_ids)
            set(kind cpp)
            get_property(archs GLOBAL PROPERTY SGL_CPP_OPERATOR_${id}_SUPPORTED_ARCHS)
        else()
            message(FATAL_ERROR "Unknown operator ID: ${id}")
        endif()
        set(reason)
        if(selection_BUILD_TYPE AND NOT kind STREQUAL selection_BUILD_TYPE)
            set(reason "build type ${kind} conflicts with requested ${selection_BUILD_TYPE}")
        elseif(NOT selection_ARCH IN_LIST archs)
            set(reason "does not support requested ARCH ${selection_ARCH} (supports ${archs})")
        endif()
        if(reason)
            if(selection_OPERATORS STREQUAL "ALL")
                message(STATUS "Excluded ${kind} operator: ${id}: ${reason}")
                continue()
            endif()
            message(FATAL_ERROR "Operator ${id}: ${reason}")
        endif()
        list(APPEND ${kind} "${id}")
    endforeach()
    if(NOT cann AND NOT cpp)
        message(FATAL_ERROR "No operators match the requested build type and architecture")
    endif()
    if(cann)
        sgl_select_operators(cann ARCH "${selection_ARCH}" OPERATORS ${cann})
    endif()
    sgl_collect_cpp_sources(cpp_sources cpp_definitions ${cpp})
    set(${out_cann} "${cann}" PARENT_SCOPE)
    set(${out_cpp} "${cpp}" PARENT_SCOPE)
endfunction()
