# Host C++ operators have no CANN OpDef, Tiling or device Kernel.
# Keep their declarations separate so existing CANN declarations stay unchanged.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/operators.cmake")
set(SGL_CPP_OPERATOR_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")

function(sgl_register_cpp_operator)
    _sgl_check_operator_keywords("ID;SUPPORTED_ARCHS;SOURCES;TORCH_ADAPTER" ${ARGV})
    cmake_parse_arguments(PARSE_ARGV 0 op "" "ID;TORCH_ADAPTER" "SUPPORTED_ARCHS;SOURCES")
    if(NOT "${op_UNPARSED_ARGUMENTS}" STREQUAL "" OR NOT "${op_KEYWORDS_MISSING_VALUES}" STREQUAL "")
        message(FATAL_ERROR "Invalid CPP operator arguments: ${op_UNPARSED_ARGUMENTS}; missing values: ${op_KEYWORDS_MISSING_VALUES}")
    endif()
    foreach(field IN ITEMS ID SUPPORTED_ARCHS SOURCES TORCH_ADAPTER)
        if(NOT DEFINED op_${field} OR "${op_${field}}" STREQUAL "")
            message(FATAL_ERROR "CPP operator declaration is missing required field: ${field}")
        endif()
    endforeach()
    if(NOT op_ID MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR op_ID STREQUAL "all" OR op_ID STREQUAL "ALL")
        message(FATAL_ERROR "Invalid or reserved CPP operator ID: ${op_ID}")
    endif()
    set(archs)
    foreach(arch IN LISTS op_SUPPORTED_ARCHS)
        if(NOT arch MATCHES "^(2201|3510)$" OR arch IN_LIST archs)
            message(FATAL_ERROR "Invalid or duplicate supported ARCH in ${op_ID}: ${arch}")
        endif()
        list(APPEND archs "${arch}")
    endforeach()
    get_property(ids GLOBAL PROPERTY SGL_CPP_OPERATOR_IDS)
    if(op_ID IN_LIST ids)
        message(FATAL_ERROR "Duplicate CPP operator ID: ${op_ID}")
    endif()
    # Build guards use uppercase IDs; case-only IDs must not share a guard.
    string(TOUPPER "${op_ID}" macro)
    foreach(id IN LISTS ids)
        string(TOUPPER "${id}" existing_macro)
        if(macro STREQUAL existing_macro)
            message(FATAL_ERROR "CPP operator guard collision: ${id}, ${op_ID}")
        endif()
    endforeach()
    foreach(field IN ITEMS SOURCES TORCH_ADAPTER)
        _sgl_operator_source_paths(paths "${CMAKE_CURRENT_LIST_DIR}" ${op_${field}})
        set_property(GLOBAL PROPERTY SGL_CPP_OPERATOR_${op_ID}_${field} "${paths}")
    endforeach()
    set_property(GLOBAL PROPERTY SGL_CPP_OPERATOR_${op_ID}_SUPPORTED_ARCHS "${op_SUPPORTED_ARCHS}")
    set_property(GLOBAL APPEND PROPERTY SGL_CPP_OPERATOR_IDS "${op_ID}")
endfunction()

function(sgl_add_cpp_operator_domains)
    add_subdirectory("${SGL_CPP_OPERATOR_ROOT}/data_move" "declarations/data_move")
endfunction()

# Only selected implementation and registration files enter the Torch target.
# A source shared by several IDs is compiled once, with per-ID entrypoint guards.
function(sgl_collect_cpp_sources out_sources out_definitions)
    set(sources)
    set(definitions)
    get_property(ids GLOBAL PROPERTY SGL_CPP_OPERATOR_IDS)
    foreach(id IN LISTS ARGN)
        if(NOT id IN_LIST ids)
            message(FATAL_ERROR "Unknown CPP operator ID: ${id}")
        endif()
        foreach(field IN ITEMS SOURCES TORCH_ADAPTER)
            get_property(paths GLOBAL PROPERTY SGL_CPP_OPERATOR_${id}_${field})
            foreach(path IN LISTS paths)
                if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
                    message(FATAL_ERROR "CPP operator source is not an existing file: ${path}")
                endif()
                list(APPEND sources "${path}")
            endforeach()
        endforeach()
        string(TOUPPER "${id}" macro)
        list(APPEND definitions "SGL_CPP_${macro}=1")
    endforeach()
    list(REMOVE_DUPLICATES sources)
    set(${out_sources} "${sources}" PARENT_SCOPE)
    set(${out_definitions} "${definitions}" PARENT_SCOPE)
endfunction()
